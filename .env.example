# Frontend API base (Vite build-time setting; separate from ASTRA_PUBLIC_URL).
# Local development: direct URL to the local FastAPI server.
VITE_ASTRA_API_URL=http://localhost:8000
# Vercel production and Preview: set VITE_ASTRA_API_URL=/api.
# vercel.ts proxies /api/* to production or the explicitly configured staging
# backend over HTTPS using the same Vercel origin.
# Preview additionally requires ASTRA_STAGING_BACKEND_URL in Vercel.

# Backend settings. Use a stable, private random secret in deployment.
# SQLite remains the default when DATABASE_URL is unset.
# Optionally override the local SQLite file path:
# ASTRA_SQLITE_PATH=backend/astra_users.db
# Optional: Supabase PostgreSQL connection URI.
# Leave unset to use local SQLite.
# Never commit the actual connection URI or password.
# DATABASE_URL=
ASTRA_AUTH_SECRET=replace-with-a-random-secret
# Set true in production; HTTPS is required when enabled.
ASTRA_COOKIE_SECURE=false

# Email verification (Resend); use a verified sender domain in production.
RESEND_API_KEY=re_replace-with-your-resend-api-key
ASTRA_EMAIL_FROM=ASTRA <verify@example.com>
# Public frontend origin and verification-link base; also used for Google origin checks.
ASTRA_PUBLIC_URL=http://localhost:5173

# Google Identity Services OAuth 2.0 Web client ID; authorize ASTRA_PUBLIC_URL as a JS origin.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# PostgreSQL integration checks require a separate, verified non-production database.
# Configure these only in the shell that runs scripts/verify_postgres.py.
# ASTRA_TEST_DATABASE_PROJECT=ASTRA_STAGING
# ASTRA_TEST_DATABASE_PROJECT_REF=
# ASTRA_TEST_DATABASE_URL=
# ASTRA_TEST_DATABASE_HOST=
# ASTRA_TEST_DATABASE_NAME=
# ASTRA_RUN_POSTGRES_INTEGRATION=1
# ASTRA_ALLOW_POSTGRES_TEST_WRITES=I_HAVE_VERIFIED_THIS_IS_NON_PRODUCTION
